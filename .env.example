# Server-only database connection. Configure Turso in deployed environments.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-read-only-token

# Optional local development fallback. Never set this on Vercel.
STICKERHUB_SQLITE_PATH=/absolute/path/to/emoticon-turso.db

# Writable API Key Store. Keep this separate from the read-only catalog database.
# For production, configure both of these server-side secrets:
# NUXT_API_KEYS_DATABASE_URL=libsql://your-api-keys.turso.io
# NUXT_API_KEYS_AUTH_TOKEN=replace-with-a-writable-api-keys-token
# Local development only. Never set this on Vercel: use the remote Key Store
# variables above. Existing legacy .data/stickermart-api-keys.db files are
# detected automatically when no path is set.
NUXT_API_KEYS_SQLITE_PATH=.data/stickerhub-api-keys.db

# Administrator credential for /api/admin/keys. Generate a long random value
# and keep it in the deployment platform's secret store.
NUXT_ADMIN_API_KEY=replace-with-an-admin-api-key

# Required to seal administrator sessions. Generate a separate 32+ character
# random value and never reuse the administrator API key here.
NUXT_SESSION_PASSWORD=replace-with-a-separate-32-character-session-secret

# Optional transactional email. Key emails never contain the API Key itself.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=
# Configure a Resend webhook for /api/webhooks/resend to track delivery results.
NUXT_RESEND_WEBHOOK_SECRET=

# Comma-separated browser origins allowed to call /api/v1/*.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional durable production rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
API_RATE_LIMIT=60

# Public HTTPS site URL used by SEO and transactional email links. Keep indexing disabled outside production.
NUXT_SITE_URL=https://stickerhub.lius.me
NUXT_SITE_INDEXABLE=false
